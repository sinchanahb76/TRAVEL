# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# OPENWEATHER_API_KEY / VITE_OPENWEATHER_API_KEY: Optional OpenWeather API key for live weather forecasts.
OPENWEATHER_API_KEY=
VITE_OPENWEATHER_API_KEY=

# MONGODB_URI: Optional MongoDB Atlas connection string for persistence.
MONGODB_URI=

# FLIGHT_API_KEY: Configurable server-side API key for live flight search provider.
FLIGHT_API_KEY=

# Firebase Authentication Configuration (Web Client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Authentication Configuration (Expo Mobile)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_API_URL=

